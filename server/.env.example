# VSAIPTV Server Environment Configuration Example
PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_jwt_secret_here
ADMIN_PASSWORD=your_master_admin_password_here
CLIENT_PASSWORD=your_default_client_password_here
IPTV_DB=./server/data/iptv.db

# ===== Área XXX (conteúdo adulto) =====
# Pasta com as listas M3U/Xtream do conteúdo adulto (padrão: ./list/XXX, varredura recursiva)
# XXX_LIST_DIR=./list/XXX
# Limite em bytes para importar os M3U locais da pasta list/XXX (padrão: 52428800 = 50MB)
# XXX_LOCAL_IMPORT_LIMIT_BYTES=52428800

# ===== Legendas IA (SubtitleAgent) =====
SUBTITLE_AI_ENABLED=true
SUBTITLE_BACKGROUND_ENABLED=true
SUBTITLE_MAX_CONCURRENT_JOBS=1
SUBTITLE_SCAN_BATCH_SIZE=25
SUBTITLE_MAX_QUEUE_SIZE=500
SUBTITLE_QUEUE_TICK_MS=15000
SUBTITLE_SCAN_INTERVAL_MS=600000
SUBTITLE_LOCK_TTL_MS=1800000
SUBTITLE_SEGMENT_MINUTES=10
SUBTITLE_MAX_LINE_CHARS=42
SUBTITLE_TARGET_LANGUAGE=pt-BR
SUBTITLE_STORAGE_PATH=
SUBTITLE_TEMP_DIR=
SUBTITLE_FFMPEG_TIMEOUT_MS=600000
SUBTITLE_REQUEST_RATE_MAX=6
SUBTITLE_BACKGROUND_START_HOUR=
SUBTITLE_BACKGROUND_END_HOUR=
SUBTITLE_DAILY_AUDIO_MINUTES=
SUBTITLE_DAILY_AI_BUDGET=

# ===== ASR (Speech-to-Text) =====
# whisper-local | external-api | none
ASR_PROVIDER=whisper-local
ASR_API_URL=http://localhost:9000/v1
ASR_MODEL=
ASR_API_KEY=
ASR_TIMEOUT_MS=900000

# ===== FFmpeg (caminhos opcionais) =====
FFMPEG_PATH=
FFPROBE_PATH=
