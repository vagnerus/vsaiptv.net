<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (TV Box / D-pad selected) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="2.5dp" android:color="@color/focus_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    
    <!-- Pressed (Touch / Click) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_surface" />
            <stroke android:width="2dp" android:color="@color/secondary" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Normal Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/border_color" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
