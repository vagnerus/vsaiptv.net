{
  "id": "/?source=pwa",
  "name": "VSAIPTV - Streaming & VOD",
  "short_name": "VSAIPTV",
  "description": "Plataforma Premium de TV Ao Vivo, Filmes e Séries em Alta Definição.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#080B11",
  "theme_color": "#6366F1",
  "categories": ["entertainment", "video"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.nexus.iptv",
      "url": "https://play.google.com/store/apps/details?id=com.nexus.iptv"
    }
  ],
  "scope_extensions": [],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/?action=open_file",
      "name": "Lista M3U / Playlist",
      "accept": {
        "application/x-mpegurl": [".m3u", ".m3u8"],
        "audio/x-mpegurl": [".m3u", ".m3u8"]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+iptv",
      "url": "/?stream=%s"
    },
    {
      "protocol": "web+stream",
      "url": "/?stream=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "VSAIPTV Destaques",
      "short_name": "Destaques",
      "description": "Canais e filmes em destaque ao vivo",
      "tag": "vsaiptv_highlights",
      "template": "widget-template",
      "ms_ac_template": "/widgets/template.json",
      "data": "/widgets/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-desktop.png",
          "sizes": "1280x720",
          "label": "Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "handle_links": "preferred",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "VSAIPTV TV e Desktop Player"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "VSAIPTV Mobile App"
    }
  ],
  "shortcuts": [
    {
      "name": "TV Ao Vivo",
      "url": "/?tab=live",
      "description": "Assistir canais ao vivo"
    },
    {
      "name": "Filmes VOD",
      "url": "/?tab=movies",
      "description": "Assistir filmes sob demanda"
    }
  ]
}
